# Modelo das variáveis de ambiente do Horun · Financeiro EM PRODUÇÃO
# (docker-compose.yml, plugado no Horun Core — passo a passo em docs/DEPLOY.md).
# Copie para `.env` e preencha — o `.env` nunca é versionado (.gitignore).
# Este repositório é PÚBLICO: nenhum valor real entra aqui.
# (Para rodar localmente sem Docker, use o Apresentar_Financeiro.bat ou as
# variáveis descritas em docs/ESTADO_E_PLANOS.md, seção 3.)

# Senha do PostgreSQL do módulo (o compose monta a URL do banco com ela).
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Assina a sessão de coordenador. OBRIGATÓRIA, 32+ caracteres (o módulo não
# sobe sem ela). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MODULE_SECRET_KEY=

# Senha mestra de coordenador INICIAL — usada só na primeira subida, para
# criar o registro; depois os coordenadores trocam pela interface. Sem ela, o
# login de coordenador fica indisponível (não existe senha padrão).
MODULE_COORDENADOR_PASSWORD=

# Limite por arquivo enviado pela tela (MB).
MODULE_MAX_UPLOAD_MB=50

# Drive (OneDrive). No servidor: "agent" — quem lê é o Horun Agent instalado no
# PC onde o OneDrive sincroniza; MODULE_DRIVE_AGENT_ROOT é o nome da pasta
# liberada no config.json do agente. "local" só serve se o OneDrive estiver
# nesta mesma máquina (MODULE_DRIVE_ROOT = caminho da pasta).
MODULE_DRIVE_MODE=agent
MODULE_DRIVE_AGENT_ROOT=financeiro
MODULE_DRIVE_ROOT=
# Quanto o backend espera o agente responder a uma tarefa (s).
MODULE_AGENT_TASK_TIMEOUT=30

# Backup do banco: pasta do Windows FORA do Docker, dias guardados, intervalo.
BACKUP_DIR=C:/HorunBackups/financeiro
BACKUP_KEEP_DAYS=30
BACKUP_INTERVAL_HOURS=24

# Avisos (sininho + e-mail) pelo Horun Core — opcional. O administrador gera a
# chave em Core → Admin → Módulos → Notificações ("gerar chave"). Sem as duas,
# o módulo funciona igual, só sem avisos.
HORUN_CORE_URL=http://horun-core-backend:8000
HORUN_NOTIFY_TOKEN=
