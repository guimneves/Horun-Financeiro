# Modelo das variáveis de ambiente do Horun · Financeiro.
# Copie para `.env` e preencha — o `.env` nunca é versionado (.gitignore).
# Este repositório é PÚBLICO: nenhum valor real entra aqui.

# Só em desenvolvimento standalone: toda requisição vira o usuário "admin",
# sem login. Em produção (atrás do Core), deixar "false" ou ausente.
HORUN_DEV_MODE=false

# Banco. Produção: PostgreSQL do servidor. Vazio = SQLite local de dev.
MODULE_DATABASE_URL=postgresql+psycopg://financeiro:TROQUE@financeiro-db:5432/financeiro

# Assina a sessão de coordenador. OBRIGATÓRIA fora do DEV_MODE, 32+ caracteres
# (o módulo não sobe sem ela). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MODULE_SECRET_KEY=

# Senha mestra de coordenador INICIAL — usada só na primeira subida, para
# criar o registro; depois os coordenadores trocam pela interface. Sem ela, o
# login de coordenador fica indisponível (não existe senha padrão).
MODULE_COORDENADOR_PASSWORD=

# Documentos enviados pela API (vira volume Docker nomeado em produção).
MODULE_UPLOAD_ROOT=./uploads
# Limite por arquivo enviado (MB).
MODULE_MAX_UPLOAD_MB=50

# Pasta do OneDrive que contém a pasta de cada projeto (só leitura).
# Vazio = recurso de drive desligado.
MODULE_DRIVE_ROOT=

# Avisos (sininho + e-mail) pelo Horun Core — opcional. O administrador gera a
# chave em Core → Admin → Módulos → Notificações ("gerar chave"). Sem as duas,
# o módulo funciona igual, só sem avisos. Ex.: HORUN_CORE_URL=http://horun-core-backend:8000
HORUN_CORE_URL=
HORUN_NOTIFY_TOKEN=
